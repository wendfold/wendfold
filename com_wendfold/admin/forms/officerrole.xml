<form>
	<fieldset name="details" label="COM_WENDFOLD_OFFICER_ROLE_DETAILS">
		<field name="id" type="hidden" filter="integer" />
		<field
			name="title"
			type="text"
			label="JGLOBAL_TITLE"
			description="COM_WENDFOLD_LOOKUP_TITLE_DESC"
			required="true"
			maxlength="255"
			filter="string"
		/>
		<field
			name="system_key"
			type="text"
			label="COM_WENDFOLD_OFFICER_ROLE_SYSTEM_KEY"
			description="COM_WENDFOLD_OFFICER_ROLE_SYSTEM_KEY_DESC"
			maxlength="50"
			filter="string"
			hint="head_road_captain"
		/>
		<field
			name="published"
			type="list"
			label="JSTATUS"
			default="1"
			filter="integer"
		>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field
			name="ordering"
			type="number"
			label="JGRID_HEADING_ORDERING"
			default="0"
			filter="integer"
		/>
	</fieldset>
</form>
