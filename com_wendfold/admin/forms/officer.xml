<form>
    <fieldset name="details" label="COM_WENDFOLD_OFFICER_FIELDSET_DETAILS">
        
        <!-- Profile Selection -->
        <field
            name="id"
            type="hidden"
        />

        <field
            name="profile_id"
            type="sql"
            label="COM_WENDFOLD_OFFICER_FIELD_MEMBER_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_MEMBER_DESC"
            required="true"
            query="SELECT p.id AS value, CONCAT(u.name, ' (', p.member_number, ')') AS text 
                   FROM #__wendfold_profiles AS p 
                   INNER JOIN #__users AS u ON u.id = p.user_id 
                   WHERE p.published = 1 
                   ORDER BY u.name"
            key_field="value"
            value_field="text"
            class="form-select"
        />

        <field
            name="role_id"
            type="lookup"
            lookup="officerrole"
            addfieldprefix="Wendfold\Component\Wendfold\Administrator\Field"
            label="COM_WENDFOLD_OFFICER_FIELD_ROLE_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_ROLE_DESC"
            required="true"
            filter="integer"
            class="form-select"
        />

        <!-- Role Display Order -->
        <field
            name="role_order"
            type="number"
            label="COM_WENDFOLD_OFFICER_FIELD_ROLE_ORDER_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_ROLE_ORDER_DESC"
            default="99"
            min="0"
            max="999"
            step="1"
            class="form-control"
            hint="1"
        />

        <!-- Term Start Date -->
        <field
            name="term_start"
            type="calendar"
            label="COM_WENDFOLD_OFFICER_FIELD_TERM_START_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_TERM_START_DESC"
            format="%Y-%m-%d"
            filter="date"
            class="form-control"
        />

        <!-- Term End Date -->
        <field
            name="term_end"
            type="calendar"
            label="COM_WENDFOLD_OFFICER_FIELD_TERM_END_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_TERM_END_DESC"
            format="%Y-%m-%d"
            filter="date"
            class="form-control"
        />

        <!-- Is Current Flag -->
        <field
            name="is_current"
            type="list"
            label="COM_WENDFOLD_OFFICER_FIELD_IS_CURRENT_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_IS_CURRENT_DESC"
            default="1"
            class="form-select"
        >
            <option value="0">COM_WENDFOLD_OFFICER_FIELD_IS_CURRENT_NO</option>
            <option value="1">COM_WENDFOLD_OFFICER_FIELD_IS_CURRENT_YES</option>
        </field>

        <!-- Published -->
        <field
            name="published"
            type="list"
            label="JSTATUS"
            description="JFIELD_PUBLISHED_DESC"
            default="1"
            class="form-select"
        >
            <option value="0">JUNPUBLISHED</option>
            <option value="1">JPUBLISHED</option>
        </field>

        <!-- Admin Notes -->
        <field
            name="notes"
            type="textarea"
            label="COM_WENDFOLD_OFFICER_FIELD_NOTES_LABEL"
            description="COM_WENDFOLD_OFFICER_FIELD_NOTES_DESC"
            rows="5"
            cols="40"
            filter="string"
            class="form-control"
        />

    </fieldset>

    <!-- Standard Joomla metadata fields -->
    <fieldset name="metadata" label="COM_WENDFOLD_OFFICER_FIELDSET_METADATA">
        
        <field
            name="created"
            type="calendar"
            label="COM_WENDFOLD_OFFICER_FIELD_CREATED_LABEL"
            readonly="true"
            format="%Y-%m-%d %H:%M:%S"
            filter="server_utc"
            class="form-control"
        />

        <field
            name="modified"
            type="calendar"
            label="COM_WENDFOLD_OFFICER_FIELD_MODIFIED_LABEL"
            readonly="true"
            format="%Y-%m-%d %H:%M:%S"
            filter="server_utc"
            class="form-control"
        />

    </fieldset>
</form>
