<?xml version="1.0" encoding="utf-8"?>
<form>
    <field name="id" type="hidden" filter="integer" default="0" />

    <field name="title"
           type="text"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_TITLE_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_TITLE_DESC"
           size="30"
           maxlength="150"
           required="true"
           filter="string" />

    <field name="description"
           type="textarea"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_DESCRIPTION_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_DESCRIPTION_DESC"
           rows="3"
           cols="30"
           filter="string" />

    <field name="slot_count"
           type="number"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_SLOT_COUNT_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_SLOT_COUNT_DESC"
           min="1"
           max="99"
           step="1"
           default="1"
           filter="integer" />

    <field name="shift_label"
           type="text"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_SHIFT_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_SHIFT_DESC"
           size="20"
           maxlength="80"
           filter="string" />

    <field name="start_time"
           type="text"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_START_TIME_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_START_TIME_DESC"
           size="10"
           maxlength="8"
           filter="string"
           hint="COM_WENDFOLD_FIELD_TIME_HINT" />

    <field name="end_time"
           type="text"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_END_TIME_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_END_TIME_DESC"
           size="10"
           maxlength="8"
           filter="string"
           hint="COM_WENDFOLD_FIELD_TIME_HINT" />

    <field name="requires_road_captain"
           type="radio"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_REQUIRES_RC_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_REQUIRES_RC_DESC"
           default="0"
           layout="joomla.form.field.radio.switcher">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>

    <field name="requires_road_crew"
           type="radio"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_REQUIRES_CREW_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_REQUIRES_CREW_DESC"
           default="0"
           layout="joomla.form.field.radio.switcher">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>

    <field name="members_only"
           type="radio"
           label="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_MEMBERS_ONLY_LABEL"
           description="COM_WENDFOLD_FIELD_VOLUNTEER_ROLE_MEMBERS_ONLY_DESC"
           default="1"
           layout="joomla.form.field.radio.switcher">
        <option value="0">JNO</option>
        <option value="1">JYES</option>
    </field>

    <field name="published"
           type="radio"
           label="JSTATUS"
           description="JFIELD_PUBLISHED_DESC"
           default="1"
           layout="joomla.form.field.radio.switcher">
        <option value="0">JUNPUBLISHED</option>
        <option value="1">JPUBLISHED</option>
    </field>
</form>
